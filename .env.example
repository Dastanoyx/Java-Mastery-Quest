# Java Mastery Quest — Docker Compose settings.
# Copy to .env (git-ignored) and edit:   cp .env.example .env
# Compose reads .env automatically from the repository root.

# --- PostgreSQL ----------------------------------------------------------------------------------------------
# Only applied when the data volume is created for the first time (PostgreSQL initdb). Changing them later
# does NOT change the existing database user/password — see docs/OPERATIONS.md "Troubleshooting".
# The password is embedded in a postgres:// URL, so stick to URL-safe characters (letters, digits, - _ . ~).
POSTGRES_DB=jmq
POSTGRES_USER=jmq
POSTGRES_PASSWORD=change-me-local-only

# --- Web -----------------------------------------------------------------------------------------------------
# Host port for the app. It is bound to 127.0.0.1 only: http://127.0.0.1:3000
WEB_PORT=3000
# The app only answers requests addressed to localhost / 127.0.0.1 (protection against DNS rebinding).
# If you open it under another name (e.g. a hostname on your LAN), list it here, comma-separated.
ALLOWED_HOSTS=

# --- Runner --------------------------------------------------------------------------------------------------
# Shared secret between web and runner (sent as "Authorization: Bearer <token>").
# Generate one with:   openssl rand -hex 32
# Leave empty to disable the check (the runner is only reachable from the web container either way).
RUNNER_TOKEN=change-me
